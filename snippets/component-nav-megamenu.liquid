<style>
  #main-header .nav-megamenu {
    position: absolute;
    left: 0;
    top: 100%;
    width: 100%;
    margin-top: 1px;
    display: flex;
    padding: 3rem 5rem;
  }
  #main-header .nav-megamenu .page-width {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-inline: auto;
    align-items: flex-start;
    padding: 0 2rem;

    & > li {
      padding-left: 1.5rem;
      border-left: 1px solid #D9D9D9;
      height: 100%;
    }
  }
  #main-header .nav-megamenu .nav-megamenu_child {
    position: static;
    margin-top: 10px;
    display: block;
  }
  #main-header .nav-megamenu_heading {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: .6rem;
  }
  #main-header .nav-megamenu_child a {
    display: block;
    padding: 8px 0;
    font-size: 13px;
    font-weight: 400;
    line-height: 100%;
  }
</style>
<ul>
  {% for link in section.settings.menu.links %}
    <li x-data="{ menuOpen: false }" @click.outside="menuOpen = false">
      {% if link.links != blank %}
        <button
          @click="menuOpen = !menuOpen"
          :class="{ 'menu-open': menuOpen }"
          class="menu-toggle"
        >
          {{- link.title | escape -}}
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
        <div x-show="menuOpen" x-transition x-cloak class="nav-megamenu color-{{ section.settings.menu_color_scheme }} gradient">
          <ul class="nav-megamenu_special">
            {%- for childlink in link.links -%}
              {%- if childlink.title contains ' | special' -%}
                <li>
                  <a
                    href="{{ childlink.url }}"
                    class="nav-megamenu_heading"
                    {% if childlink.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {%- liquid
                      assign collection = null
    
                      assign url_parts = childlink.url | split: '/collections/'
                      if url_parts.size > 1
                        assign collection_handle = url_parts[1]
                        assign collection = collections[collection_handle]
                      endif
                    -%}
                    {%- if collection != blank and collection.featured_image != blank -%}
                      {{
                        collection.featured_image
                        | image_url: width: 40
                        | image_tag: loading: 'lazy'
                      }}
                    {%- endif -%}
                    {{ childlink.title | remove: ' | special' | escape }}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <ul class="page-width" role="list">
            {%- for childlink in link.links -%}
              {%- unless childlink.title contains ' | special' -%}
                <li>
                  <a
                    href="{{ childlink.url }}"
                    class="nav-megamenu_heading"
                    {% if childlink.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {%- liquid
                      assign collection = null
    
                      assign url_parts = childlink.url | split: '/collections/'
                      if url_parts.size > 1
                        assign collection_handle = url_parts[1]
                        assign collection = collections[collection_handle]
                      endif
                    -%}
                    {%- if collection != blank and collection.featured_image != blank -%}
                      {{
                        collection.featured_image
                        | image_url: width: 40
                        | image_tag: loading: 'lazy'
                      }}
                    {%- endif -%}
                    {{ childlink.title | escape }}
                  </a>
                  {%- if childlink.links != blank -%}
                    <ul class="nav-megamenu_child" role="list">
                      {%- for grandchildlink in childlink.links -%}
                        <li>
                          <a
                            href="{{ grandchildlink.url }}"
                            {% if grandchildlink.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ grandchildlink.title | escape }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        </div>
      {% else %}
        <a
          href="{{ link.url }}"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          {{- link.title | escape -}}
        </a>
      {% endif %}
    </li>
  {% endfor %}
</ul>
